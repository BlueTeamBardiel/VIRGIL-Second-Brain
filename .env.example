# VIRGIL — Environment Variables
# Copy this file to .env and edit the values you need.
# .env is gitignored — your keys stay local.

# ── Inference backend ─────────────────────────────────────────────────────────
# Pick one: "anthropic" (cloud API) or "ollama" (local).
# See ARCHITECTURE.md §7 for the trade-offs.
VIRGIL_BACKEND=anthropic

# ── Anthropic API ─────────────────────────────────────────────────────────────
# Required when VIRGIL_BACKEND=anthropic.
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Ollama (local inference) ──────────────────────────────────────────────────
# Used when VIRGIL_BACKEND=ollama. Pick a model that fits your VRAM —
# see ARCHITECTURE.md §7.2 for sizing.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# ── Vault location ────────────────────────────────────────────────────────────
# Root path of your VIRGIL vault. Default if unset: $HOME/VIRGIL
# VIRGIL_DIR=/home/your-username/VIRGIL
